# Sao chép thành .env rồi đổi giá trị. KHÔNG commit file .env lên GitHub.
TRACKER_URL=http://127.0.0.1:8000
# Mật khẩu chung để peer được tham gia mạng (tracker chỉ giữ bản băm SHA-256)
JOIN_KEY=change-me-join-key
# Khóa bí mật tracker dùng để ký token (HMAC-SHA256). Chỉ đặt ở máy chạy tracker.
TRACKER_SECRET=change-me-long-random-secret
TOKEN_TTL=86400

HEARTBEAT_INTERVAL=3
PEER_TIMEOUT=10

CHUNK_SIZE=262144
MAX_BODY=8388608
MAX_UPLOAD_CONNS=8
MAX_DOWNLOAD_WORKERS=4
MAX_REQUESTS_PER_PEER=3
CONNECT_TIMEOUT=3
REQUEST_TIMEOUT=10
MAX_CHUNK_RETRIES=5
MAX_PEER_STRIKES=3
PEER_COOLDOWN=3
PEER_REFRESH_INTERVAL=2
STALL_TIMEOUT=60
TRACKER_RETRIES=3

DATA_DIR=data
LOG_DIR=logs
